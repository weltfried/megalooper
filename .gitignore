# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# SuperCollider
*.scsyndef

# Python's bytecode, written when a tool is imported as a module
__pycache__/

# Training-data exports: keep the labelled onset sidecars (the analyzer's
# regression corpus) in git, but not the large binary loop audio.
training-data/*.wav
presets/granular/*.scd

# Recorded sets: two WAVs per session, hundreds of MB a gig.
sessions/

# The duo's labelled uneven-bars takes (their onsets and their riffs' pitch,
# taken from sessions/): private like the sets they come from. The tests
# that read them skip when the file is not there.
scripts/tests/fixtures/uneven-takes.json

# Megalooper SA: BIAS FX state exported from the Live set by
# tools/export-live-set.py biasfx, and the sound Keep sound kept (current.fxb
# and current.scd). Regenerated from the set or the rig, not committed.
presets/sa/biasfx/
# The drum render: the set's copy (regenerated by `drumrender`) and what Live
# renders from it, tens of MB. The .mid files and their maps are committed.
presets/sa/drums/*.als
presets/sa/drums/*.wav
# The effects' presets: settings (.scd) and Bias FX's bank (.fxb, ~200 kB)
# per name. Personal, like the granular ones; the folder is kept.
presets/sa/fx/*.scd
presets/sa/fx/*.fxb
# Megalooper SA drums: each kit's audio, copied by tools/export-live-set.py
# kits from Ableton's Core Library and pack previews into a folder per kit
# (and _ir/, the drum reverb's impulse responses). Ableton's audio, never
# committed; the kit JSON files beside the folders are. A hand-made kit may
# keep its samples beside the JSON files: audio there is ignored too.
presets/sa/drums/kits/*/
presets/sa/drums/kits/*.wav
presets/sa/drums/kits/*.wave
presets/sa/drums/kits/*.aif
presets/sa/drums/kits/*.aiff
presets/sa/drums/kits/*.aifc
presets/sa/drums/kits/*.ogg
presets/sa/drums/kits/*.flac
# The Drums tab's presets (personal, like the effects'; the folder is kept)
# and the sounds Keep keeps.
presets/sa/drum-presets/*.scd
presets/sa/kept/

# Design documents and build logs, kept out of the public repository.
docs/dev/
