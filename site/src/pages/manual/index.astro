---
// /manual/ opens chapter 1.
import { chapters, chapterHref } from '../../lib/manual';
const to = chapterHref(import.meta.env.BASE_URL, chapters[0].slug);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>megalooper manual</title>
  </head>
  <body><a href={to}>The megalooper manual</a></body>
</html>
