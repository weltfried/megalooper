      ]
    },
    {
      "n": 5, "slug": "looping", "title": "Looping", "group": "PLAYING", "layer": "loop", "rig": "every",
      "sources": [
        { "file": "docs/manual.md", "heading": "### Keyboard (the megalooper window must be focused)", "title": "Keyboard" }
      ]
    },
    {
      "n": 6, "slug": "breaks", "title": "Breaks and the arc", "group": "PLAYING", "layer": "loop", "rig": "every",
      "sources": [
        { "file": "docs/manual.md", "heading": "### Breaks" },
        { "file": "docs/manual.md", "heading": "### The arc — intensity and dissolve" }
      ]
    },
    {
      "n": 7, "slug": "meter", "title": "How the meter is found", "group": "PLAYING", "layer": "loop", "rig": "every",
      "lead": "You play a phrase in free time and press R again. In the time it takes the loop to come round, megalooper decides the tempo, the meter, how many bars and where beat 1 is. This chapter is about how it decides, and what to do when it decides wrong.",
      "sources": [
        { "file": "docs/manual.md", "heading": "## How meter detection works", "unwrap": true, "introTitle": "Fitting a grid" },
        { "file": "docs/manual.md", "heading": "### The next reading" },
        { "file": "docs/manual.md", "heading": "### Overdub meter detection" },
        { "file": "docs/manual.md", "heading": "## Exporting training data" }
      ],
      "figures": [
        { "section": "Accent analysis", "after": 1, "file": "fig-accent-template.html" },
        { "section": "Uneven bars", "after": 2, "file": "fig-uneven-bars.html" }
      ]
    },
    {
      "n": 8, "slug": "onsets", "title": "Onsets and onset notes", "group": "PLAYING", "layer": "loop", "rig": "every",
