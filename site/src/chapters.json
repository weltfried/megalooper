{
  "$comment": [
    "Drives the manual: the rail, the numbering, prev/next and what each chapter is made of.",
    "A source is a heading range in one of the repo's Markdown files, which stay the single source of truth.",
    "  file      path from the repo root",
    "  heading   '## Text' (level and text must match one top-level heading); left out = the whole file under its H1",
    "  part      'intro' = only the text before the heading's first subheading",
    "  unwrap    true = drop the heading itself and promote its subheadings to sections",
    "  title     replaces the heading's text (wrapped sources only)",
    "  introTitle  with unwrap: give the text before the first subheading a section of its own",
    "The first unwrapped source's intro becomes the chapter's opening text; its first paragraph is the lead unless 'lead' is set.",
    "omit lists what is left out on purpose, so the build's coverage check stays quiet about it."
  ],
  "groups": ["START", "PLAYING", "SOUND", "MEGALOOPER SA", "CONNECT", "REFERENCE"],
  "fileHomes": {
    "README.md": "welcome",
    "docs/manual.md": "looping"
  },
  "chapters": [
    {
      "n": 1, "slug": "welcome", "title": "Welcome", "group": "START", "rig": "every",
      "sources": [
        { "file": "README.md", "part": "intro", "unwrap": true },
        { "file": "README.md", "heading": "## What it does" },
        { "file": "README.md", "heading": "## Licence" },
        { "file": "README.md", "heading": "## Trademarks" }
      ]
    },
    {
      "n": 2, "slug": "install", "title": "Installing and the first run", "group": "START", "rig": "every",
      "sources": [
        { "file": "README.md", "heading": "## What you need" },
        { "file": "README.md", "heading": "## Install" },
        { "file": "README.md", "heading": "## First run" },
        { "file": "docs/manual.md", "heading": "## Running", "unwrap": true, "introTitle": "Running" }
      ]
    },
    {
      "n": 3, "slug": "routing", "title": "Audio settings", "group": "START", "rig": "every",
      "sources": [
        { "file": "docs/manual.md", "heading": "## Configuration", "unwrap": true },
        { "file": "docs/routing.md", "unwrap": true }
      ]
    },
    {
      "n": 4, "slug": "window", "title": "The window", "group": "START", "rig": "every",
      "sources": [
        { "file": "docs/manual.md", "heading": "### GUI", "unwrap": true },
