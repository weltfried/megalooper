  ],
  "omit": [
    { "file": "docs/manual.md", "part": "intro", "why": "says where the other guides are; the rail does that" },
    { "file": "docs/manual.md", "heading": "## License", "why": "the README's Licence is in chapter 1" },
    { "file": "docs/manual.md", "heading": "## Controls", "part": "intro", "why": "a container heading; its subsections are spread over chapters 4-8 and 16" },
    { "file": "README.md", "heading": "## Guides", "why": "a table of the docs; the rail replaces it" }
  ]
}
